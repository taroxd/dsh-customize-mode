{
  "name": "dsh-customize-mode",
  "version": "1.2.0",
  "type": "module",
  "description": "Customize the system prompt, enabled tools, and extra context for each DeepSeek Harness conversation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taroxd/dsh-customize-mode.git"
  },
  "homepage": "https://github.com/taroxd/dsh-customize-mode#readme",
  "bugs": {
    "url": "https://github.com/taroxd/dsh-customize-mode/issues"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./runtime/1.2.0/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "runtime/1.2.0/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build-runtime.mjs",
    "test": "node --test --test-isolation=none *.test.js",
    "prepack": "node build-runtime.mjs"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
